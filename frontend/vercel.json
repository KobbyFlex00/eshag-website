{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://eshag-website.onrender.com/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://eshag-website.onrender.com/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://eshag-website.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
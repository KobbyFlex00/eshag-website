{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://eshag-website.onrender.com/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://eshag-website.onrender.com/admin/:path*"
    },
    {
      "source": "/static/admin/:path*",
      "destination": "https://eshag-website.onrender.com/static/admin/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://eshag-website.onrender.com/static/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://eshag-website.onrender.com/api/:path*"
    },
    {
      "source": "/((?!admin|api|static).*)",
      "destination": "/index.html"
    }
  ]
}